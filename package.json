    "@reduxjs/toolkit": "2.8.2",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-table": "^8.21.3",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "material-react-table": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.0.0",
    "react-router-dom": "^7.5.1"
