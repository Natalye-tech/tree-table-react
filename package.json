    "eslint": "^9.0.0",
    "express": "^4.21.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^15.5.1",
    "msw": "^2.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
